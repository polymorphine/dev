use Polymorphine\Dev\FixerSetup;
use Composer\XdebugHandler\XdebugHandler;
use PhpCsFixer\Console\Application;

$argv or exit('CLI script executable');

error_reporting(E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED);
set_error_handler(static function (int $severity, string $message, string $file, int $line): bool {
    if ($severity & error_reporting()) {
        throw new ErrorException($message, 0, $severity, $file, $line);
    }
    return true;
});

if (PHP_VERSION_ID === 80000) {
    fwrite(STDERR, 'PHP CS Fixer is not able run on PHP 8.0.0 due to bug in PHP tokenizer');
    exit(1);
}

$scriptRoot = getcwd() === __DIR__ ? __DIR__ : dirname(__DIR__, 3);
require_once CSFixerScript::path($scriptRoot, 'vendor/autoload.php');

// Restart if xdebug is loaded, unless the environment variable PHP_CS_FIXER_ALLOW_XDEBUG is set.
$xdebug = new XdebugHandler('PHP_CS_FIXER');
$xdebug->check();
unset($xdebug);

$CSFixer = new CSFixerScript(new Application());

// Command types that are not executed directly by `runScript` are customized sets of CLI arguments
$commandType = $argv[1] ?? null;
switch ($commandType) {
    case 'fix':
        $argv[2] = FixerSetup::path($argv[2]);
        FixerSetup::usingTempPath($argv[2]);
        $argv[] = '--path-mode=intersection';
        // no break
    case '--version':
    case 'list-sets':
        $exitCode = $CSFixer->runScript($argv);
        break;
    case '--fix': // simplified fix command with predefined set of cli options
        $exitCode = $CSFixer->fixFiles($argv);
        break;
    default:
        $exitCode = $CSFixer->checkFiles($argv);
}

exit($exitCode);


class CSFixerScript
{
    private const CLI_ARGS = ['--config=cs-fixer.php.dist', '--path-mode=intersection', '--show-progress=none', 'fix'];

    public static function path(string $root, string $path): string
    {
        return $root . DIRECTORY_SEPARATOR . str_replace(['/', '\\'], DIRECTORY_SEPARATOR, $path);
    }

    private Application $runner;

    public function __construct(Application $runner)
    {
        $this->runner = $runner;
    }

    public function checkFiles(array $args): int
    {
        // Check either single file or entire project
        $files = count($args) > 1 ? [$args[1]] : ['src', 'tests'];
        return $this->runScript([$args[0], '--dry-run', '-v', ...self::CLI_ARGS, ...$files]);
    }

    public function fixFiles(array $args): int
    {
        // Fix either single file or entire project
        $files = count($args) > 2 ? [$args[2]] : ['src', 'tests'];
        return $this->runScript([$args[0], ...self::CLI_ARGS, ...$files]);
    }

    public function runScript(array $args): int
    {
        $_SERVER['argv'] = $args;
        $this->runner->setAutoExit(false);
        return $this->runner->run();
    }
}
