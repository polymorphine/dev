{
    "name": "{package.name.composer}",
    "description": "{package.description}",
    "license": "MIT",
    "type": null,
    "abandoned": null,
    "version": null,
    "keywords": null,
    "readme": null,
    "time": null,
    "authors": [
        {
            "name": "{author.name}",
            "email": "{author.email}",
            "homepage": null,
            "role": null
        }
    ],
    "homepage": null,
    "support": null,
    "funding": null,
    "source": null,
    "dist": null,
    "require": {
        "php": null
    },
    "require-dev": {$tpl.REQUIRE_DEV},
    "replace": null,
    "conflict": null,
    "provide": null,
    "suggest": null,
    "repositories": null,
    "minimum-stability": null,
    "prefer-stable": null,
    "autoload": {
        "psr-4": {
            "{namespace.src.esc}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{namespace.src.esc}\\Tests\\": "tests/"
        }
    },
    "bin": null,
    "archive": null,
    "php-ext": null,
    "config": null,
    "extra": null,
    "scripts": {
        "test-cs": [
            "php-cs-fixer --dry-run -v --config=cs-fixer.php.dist --path-mode=intersection fix src tests",
            "{$tpl.PHP_EXEC}polymorphine-phpcs"
        ],
        "test-php": "phpunit",
        "test-skeleton": "{$tpl.PHP_EXEC}polymorphine-skeleton check"
    },
    "scripts-descriptions": null,
    "scripts-aliases": null
}
